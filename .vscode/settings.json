{
  "editor.formatOnSave": true,
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "tailwindCSS.classFunctions": ["cva", "cx"],
  "chat.tools.terminal.autoApprove": {
    "pnpm": true,
    "ForEach-Object": true
  }
}
